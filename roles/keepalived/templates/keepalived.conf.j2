vrrp_instance VI_1 {
  state MASTER
  interface eth1
  virtual_router_id 51
  priority 100
  advert_int 1

  authentication {
    auth_type PASS
    auth_pass 1111
  }

  virtual_ipaddress {
    192.168.56.200
  }
}


vrrp_instance VI_1 {
  state BACKUP
  interface eth1
  virtual_router_id 51
  priority 90
  advert_int 1

  authentication {
    auth_type PASS
    auth_pass 1111
  }

  virtual_ipaddress {
    192.168.56.200
  }
}



- name: Render MASTER config
  template:
    src: master.conf.j2
    dest: /etc/keepalived/keepalived.conf
  when: inventory_hostname == "proxy1"

- name: Render BACKUP config
  template:
    src: backup.conf.j2
    dest: /etc/keepalived/keepalived.conf
  when: inventory_hostname == "proxy2"
